{
  "name": "rolex-watch-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build:watch-data -- --output-directory public/watch-data && vite --mode dev.local",
    "build": "pnpm run type-check && pnpm run build-only --mode prod && pnpm run build:watch-data",
    "build:watch-data": "node ./scripts/generate-watch-data.mjs",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit",
    "bundle-analyze": "vite-bundle-visualizer",
    "lint": "eslint . --fix",
    "test:vitest": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "engines": {
    "node": ">=24.20.0",
    "npm": ">=11.19.0"
  },
  "dependencies": {
    "@lucide/vue": "^1.39.0",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.30",
    "vue-i18n": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sass": "^1.98.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.0.7",
    "vite-plugin-virtual-mpa": "^1.12.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.1.1"
  }
}
